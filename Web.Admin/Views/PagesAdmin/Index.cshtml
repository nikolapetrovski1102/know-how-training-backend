@model IEnumerable<Core.Application.DTOs.PageSummaryDto>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Pages (@Model.Count())</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Page</a>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Slug</th>
                <th>Published</th>
                <th>Menu Item</th>
                <th>Sort Order</th>
                <th>Languages</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Slug</td>
                    <td>
                        <span class="badge @(p.IsPublished ? "bg-success" : "bg-secondary")">
                            @(p.IsPublished ? "Yes" : "No")
                        </span>
                    </td>
                    <td>@p.SortOrder</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
