@model dynamic
<div class="card mb-4">
    <div class="card-header">
        <h5>Hero Section</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <label class="form-label">Title</label>
                <input asp-for="Hero.Title" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Subtitle</label>
                <input asp-for="Hero.Subtitle" class="form-control" />
            </div>
        </div>
        <div class="row mt-3">
            <div class="col-md-6">
                <label class="form-label">Primary CTA Label</label>
                <input asp-for="Hero.PrimaryCta.Label" class="form-control" />
                <input asp-for="Hero.PrimaryCta.Url" class="form-control mt-1" placeholder="URL" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Background Image</label>
                <input asp-for="Hero.BackgroundImageUrl" class="form-control" />
            </div>
        </div>
    </div>
</div>
