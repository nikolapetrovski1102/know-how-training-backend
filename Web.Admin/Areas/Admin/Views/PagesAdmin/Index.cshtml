@model IEnumerable<Core.Application.DTOs.PageSummaryDto>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers  <!-- Inline fix -->

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>📄 Pages (@Model?.Count() ?? 0)</h1>
    <a asp-area="Admin" asp-controller="PagesAdmin" asp-action="Create" class="btn btn-primary">
        ➕ New Page
    </a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 bg-light rounded-3 p-5">
        <i class="bi bi-file-earmark-text fs-1 text-muted mb-3 d-block"></i>
        <h4 class="text-muted mb-3">No pages found</h4>
        <a asp-area="Admin" asp-controller="PagesAdmin" asp-action="Create" class="btn btn-primary btn-lg">
            Create first page
        </a>
    </div>
}
else
{
    <div class="table-responsive card shadow-sm">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Slug</th>
                    <th>Status</th>
                    <th>Order</th>
                    <th style="width: 150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr class="align-middle">
                        <td>
                            <div>
                                <strong>@p.Slug</strong>
                                <div class="small text-muted">ID: @p.Id</div>
                            </div>
                        </td>
                        <td>
                            <span class="badge @(p.IsPublished ? "bg-success" : "bg-secondary") fs-6 px-3 py-2">
                                @(p.IsPublished ? "✅ Live" : "⏳ Draft")
                            </span>
                        </td>
                        <td><code>@p.SortOrder</code></td>
                        <td>
                            <a href="/Admin/PagesAdmin/Edit/@p.Id" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <a href="/?lang=mk" target="_blank" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
